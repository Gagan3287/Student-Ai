# ─── Database (Supabase Postgres) ─────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → Database → Connection String
# Format: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a secure secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-64-hex-char-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ─── Groq (PRIMARY — text generation) ─────────────────────────────────────────
# Free API key: https://console.groq.com → API Keys → Create API Key
# Used for: summarization, quiz/flashcard generation, RAG answers, concept extraction
GROQ_API_KEY=gsk_replace_with_your_groq_key
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant

# ─── Gemini (EMBEDDINGS ONLY) ─────────────────────────────────────────────────
# Free API key: https://aistudio.google.com → Get API Key (no credit card needed)
# Used ONLY for: embedding document chunks and user queries for RAG retrieval
# Groq has no embeddings endpoint, so Gemini is retained for this one task.
GEMINI_API_KEY=AIza_replace_with_your_gemini_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# ─── Supabase Storage ─────────────────────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=eyJ_replace_with_service_role_key
SUPABASE_BUCKET=studymate-uploads

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000
